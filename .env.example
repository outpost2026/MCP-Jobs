# MCP-Jobs environment template
# Copy to .env and fill in your values:  copy .env.example .env
#
# PostgreSQL connection for Faze 1 persistence (optional — without it the
# pipeline runs file-only, see "Graceful degradation" in README).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/mcpjobs

# Optional: healthchecks.io dead-man's-switch URL (scripts/healthcheck.py).
# Leave empty for dry-mode (local heartbeat log only).
HEALTHCHECKS_URL=